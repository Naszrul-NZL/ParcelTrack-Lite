{
  "name": "parceltrack-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/server.mjs --dev",
    "build": "next build",
    "start": "node scripts/server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests db --max-warnings 0",
    "test": "vitest run --project unit --project component",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:spike": "tsx --conditions=react-server scripts/image-spike.ts",
    "fixtures:files": "tsx scripts/file-fixtures.ts",
    "security:local": "node scripts/check-local-secrets.mjs --built",
    "test:persistence": "tsx --conditions=react-server scripts/persistence-probe.ts",
    "local:init": "node scripts/local-config.mjs",
    "local:up": "node scripts/supabase.mjs up",
    "local:down": "node scripts/supabase.mjs down",
    "local:status": "node scripts/supabase.mjs status",
    "db:bootstrap": "tsx --conditions=react-server scripts/db-bootstrap.ts",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:verify": "tsx --conditions=react-server scripts/db-verify.ts",
    "db:fixtures": "tsx --conditions=react-server scripts/db-fixtures.ts",
    "storage:init": "tsx --conditions=react-server scripts/storage-init.ts",
    "contract:check": "tsx scripts/contracts.ts --check",
    "contract:write": "tsx scripts/contracts.ts --write",
    "sql:lint": "tsx scripts/sql-lint.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run sql:lint && npm run contract:check"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/env": "16.4.2",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "jsdom": "29.1.1",
    "node-pg-migrate": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
